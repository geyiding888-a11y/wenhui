# ============================================================
#  这个文件只是一个"变量名清单"，里面【没有】真实密钥，可以安全地被人看到。
#  请【不要】把你的真实密钥填在这个文件里！
#
#  正确做法：双击运行「设置密钥.bat」（Mac 是「设置密钥.command」），
#           它会询问你，然后把密钥存到系统的环境变量里。
#  想手动设置也可以（Windows  PowerShell / CMD）：
#       setx LLM_API_KEY "你的密钥"
#  （设置完要重新打开一个窗口才会生效）
#
#  Mac / Linux：
#       export LLM_API_KEY="你的密钥"
# ============================================================

# 大模型服务的密钥。DeepSeek 的密钥形如 sk-xxxxxxxx
LLM_API_KEY=

# 下面两个一般不用改，除非你要换成别家的模型服务
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
