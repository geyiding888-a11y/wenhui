#!/bin/sh
# 提交前的把关：**不让密钥进 git 历史**。
#
# ## 为什么要有这道闸
#
# 密钥一旦进了提交，就**永久留在 .git 里**。删掉文件、再提交一次，
# 它还在历史里躺着——`git log -p` 一翻就出来，推到远程更是直接公开。
# 想彻底清掉得改写历史（filter-repo 那套），麻烦且容易出错。
#
# 而且这个错误**真的发生过**：写这个项目时，我把一条真实密钥原样写进了
# `tests/test_launchers.py` 的一条断言里，差点跟着第一次提交永久留下来。
# 是入库前扫描时才抓到的。
#
# 结论：靠人记着"别把密钥写进文件"是不可靠的（写测试的时候尤其容易忘，
# 因为满脑子想的是"要一个长得像密钥的样例"）。所以让机器在提交那一刻拦。
#
# ## 怎么用
#
# 正常提交，不用管它。真被拦下时，看它列出的文件和行号：
#   - 如果确实是密钥 → 改成读环境变量（见 .env.example），别写死
#   - 如果只是长得像的样例 → 用 `"sk-" + "a" * 32` 这样**拼**出来，
#     不要写字面量；或者确认无误后用 `git commit --no-verify` 跳过
#
# ## 换台电脑克隆之后要重新启用一次
#
# core.hooksPath 存在 .git/config 里，**不跟着仓库走**，所以克隆后要跑：
#     git config core.hooksPath .githooks
# （这个目录本身是入库的，规则不会丢。）

pattern='sk-[A-Za-z0-9_-]{20,}'
hits=$(git grep --cached -n -I -E "$pattern" 2>/dev/null)

if [ -n "$hits" ]; then
    echo ""
    echo "  ============================================================"
    echo "   提交被拦下：暂存的内容里有像 API 密钥的东西"
    echo "  ============================================================"
    echo ""
    echo "$hits" | sed 's/^/     /'
    echo ""
    echo "  密钥绝不能进 git —— 进去就永久留在历史里，删文件也没用。"
    echo ""
    echo "  怎么办："
    echo "    · 是真实密钥 → 改成从环境变量读，别写死（见 .env.example）"
    echo "    · 只是测试要的样例 → 用 \"sk-\" + \"a\" * 32 这样拼出来，别写字面量"
    echo "    · 确认是误报 → git commit --no-verify 跳过"
    echo ""
    exit 1
fi

exit 0
